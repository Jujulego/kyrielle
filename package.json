{
  "name": "kyrielle",
  "version": "2.8.3",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": "github:Jujulego/kyrielle",
  "description": "Tools to handle an (almost) infinite flow of data",
  "keywords": [
    "kyrielle",
    "events",
    "iterators",
    "observables"
  ],
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "jill run 'build:esm // build:types'",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run --typecheck",
    "test:types": "tsc --project tests"
  },
  "dependencies": {
    "@repeaterjs/repeater": "^3.0.5",
    "@swc/helpers": "^0.5.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jujulego/jill": "3.0.9",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.41",
    "@types/node": "24.12.2",
    "@typescript-eslint/utils": "8.61.0",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/eslint-plugin": "1.6.16",
    "eslint": "10.4.1",
    "jiti": "2.7.0",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.9",
    "vitest": "4.1.5"
  },
  "packageManager": "yarn@4.16.0"
}
