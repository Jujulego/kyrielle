{
  "name": "kyrielle",
  "version": "2.9.0",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": "github:Jujulego/kyrielle",
  "description": "Tools to handle an (almost) infinite flow of data",
  "keywords": [
    "kyrielle",
    "events",
    "iterators",
    "observables"
  ],
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "jill run 'build:esm // build:types'",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --typecheck",
    "test:types": "tsc --project tests",
    "prepare": "husky"
  },
  "dependencies": {
    "@repeaterjs/repeater": "^3.0.5",
    "@swc/helpers": "^0.5.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@jujulego/jill": "3.1.0",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.71.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.18.1"
}
